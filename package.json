{
  "name": "dart-room",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:netlify": "next build --webpack",
    "build:site": "node scripts/build-site.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .netlify",
    "test": "npm run test:game",
    "test:game": "tsx --test tests/game/*.test.ts",
    "test:site": "npm run build:site && tsx --test tests/site/*.test.ts",
    "test:e2e": "npm run build && npm run test:e2e:built",
    "test:e2e:built": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/compat": "^2.1.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.1",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.12",
    "tsx": "4.23.1",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.0",
    "eslint-config-next": {
      "brace-expansion": "5.0.8",
      "minimatch": "10.2.5"
    }
  }
}
